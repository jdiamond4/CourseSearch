<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>HoosList - UVA Course Search</title>

    <link rel="icon" type="image/x-icon" href="/favicon.ico">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">

    <meta name="theme-color" content="#232D4B">
    <link rel="icon" type="image/png" sizes="192x192" href="/android-chrome-192x192.png">
    <link rel="icon" type="image/png" sizes="512x512" href="/android-chrome-512x512.png">
    <script src="https://cdn.tailwindcss.com"></script>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Merriweather:ital,wght@0,400;0,700;0,900;1,400&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="/css/hooslist.css">
    <script src="/js/favorites.js"></script>
    <script defer src="/_vercel/insights/script.js"></script>
    <style>
        :root {
            --uva-navy: #232D4B;
            --uva-orange: #E57200;
        }

        body {
            font-family: 'Inter', sans-serif;
        }

        h1, h2, h3, h4, h5, h6 {
            font-family: 'Merriweather', serif;
        }

        html {
            scroll-behavior: smooth;
        }

        @keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(20px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .animate-fade-up {
            opacity: 0;
            animation: fadeInUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
        }

        .delay-100 { animation-delay: 0.1s; }
        .delay-200 { animation-delay: 0.2s; }

        .hero-bg {
            background-color: var(--uva-navy);
            background-image: radial-gradient(#34426b 1px, transparent 1px);
            background-size: 32px 32px;
            position: relative;
        }
    </style>
</head>
<body class="bg-gray-50">
    <header class="fixed top-0 left-0 right-0 bg-[#232D4B] shadow-sm border-b border-[#232D4B] z-50">
        <div class="container mx-auto px-6 py-4">
            <div class="flex items-center justify-between">
                <div class="flex items-center">
                    <a href="/" class="text-2xl font-bold text-[#E57200] hover:text-[#E57200]/80 transition-colors">
                        HoosList
                    </a>
                </div>
                <div class="flex items-center space-x-6">
                    <a href="/advanced-search" class="text-sm text-white hover:text-[#E57200] transition-colors">
                        Advanced Search
                    </a>
                    <a href="/schedule" class="text-sm text-white hover:text-[#E57200] transition-colors">
                        My Schedule
                        <span id="favorite-count-badge" class="ml-1 bg-[#E57200] text-white px-2 py-0.5 rounded-full text-xs" style="display: none;">0</span>
                    </a>
                    <a href="/catalog" class="text-sm text-white hover:text-[#E57200] transition-colors">
                        Browse Catalog
                    </a>
                </div>
            </div>
        </div>
    </header>

    <div class="hero-bg text-white pt-20 pb-16">
        <div class="container mx-auto px-6 py-12 relative z-10">
            <div class="text-center max-w-4xl mx-auto">
                <h1 class="text-5xl md:text-7xl font-black mb-8 text-white tracking-tight animate-fade-up">
                    <span class="text-[#E57200]">Hoos</span>List
                </h1>
                <p class="text-xl md:text-2xl text-gray-200 mb-10 leading-relaxed max-w-2xl mx-auto font-light animate-fade-up delay-100">
                    The modern course catalog for UVA students.
                    <span class="hidden md:inline">Find classes, check real-time enrollment, and build your perfect schedule.</span>
                </p>

                <div class="animate-fade-up delay-200">
                    <div class="flex flex-col sm:flex-row gap-5 justify-center items-center">
                        <a href="#departments" class="w-full sm:w-auto bg-[#E57200] text-white px-8 py-4 rounded-lg font-bold text-lg hover:bg-[#E57200]/90 transition-all shadow-lg hover:shadow-xl transform hover:-translate-y-1">
                            Browse Departments
                        </a>
                        <a href="/advanced-search" class="w-full sm:w-auto bg-transparent border-2 border-white/30 text-white px-8 py-4 rounded-lg font-bold text-lg hover:bg-white/10 transition-all hover:border-white">
                            Advanced Search
                        </a>
                    </div>
                    <p class="mt-6 text-sm text-white/60">
                        Updated for Fall 2026 • <a href="/catalog" class="underline hover:text-white">View Full Catalog</a>
                    </p>
                </div>
            </div>
        </div>
    </div>

    <section id="departments" class="departments">
        <div class="departments__intro">
            <h2>Browse by School &amp; Department</h2>
            <p>Pick a department to open the catalog with live sections and enrollment.</p>
        </div>

        <article class="school-card">
            <header class="school-card__header">
                <h3 class="school-card__name">College of Arts &amp; Sciences</h3>
            </header>
            <div class="school-card__body">
                <% if (landingButtons && landingButtons.AS && landingButtons.AS.length) { %>
                    <ul class="school__links">
                        <% landingButtons.AS.forEach(function(button) { %>
                            <li>
                                <a class="dept-link"
                                   href="/catalog?<%= button.type === 'category' ? 'category' : 'department' %>=<%= button.filter %>">
                                    <%= button.displayName %>
                                </a>
                            </li>
                        <% }); %>
                    </ul>
                <% } else { %>
                    <p class="school__soon">Departments coming soon</p>
                <% } %>
            </div>
        </article>

        <article class="school-card">
            <header class="school-card__header">
                <h3 class="school-card__name">School of Engineering &amp; Applied Science</h3>
            </header>
            <div class="school-card__body">
                <% if (landingButtons && landingButtons.ENG && landingButtons.ENG.length) { %>
                    <ul class="school__links">
                        <% landingButtons.ENG.forEach(function(button) { %>
                            <li>
                                <a class="dept-link"
                                   href="/catalog?<%= button.type === 'category' ? 'category' : 'department' %>=<%= button.filter %>">
                                    <%= button.displayName %>
                                </a>
                            </li>
                        <% }); %>
                    </ul>
                <% } else { %>
                    <p class="school__soon">Departments coming soon</p>
                <% } %>
            </div>
        </article>

        <article class="school-card">
            <header class="school-card__header">
                <h3 class="school-card__name">McIntire School of Commerce</h3>
            </header>
            <div class="school-card__body">
                <% if (landingButtons && landingButtons.MC && landingButtons.MC.length) { %>
                    <ul class="school__links">
                        <% landingButtons.MC.forEach(function(button) { %>
                            <li>
                                <a class="dept-link"
                                   href="/catalog?<%= button.type === 'category' ? 'category' : 'department' %>=<%= button.filter %>">
                                    <%= button.displayName %>
                                </a>
                            </li>
                        <% }); %>
                    </ul>
                <% } else { %>
                    <p class="school__soon">Departments coming soon</p>
                <% } %>
            </div>
        </article>

    </section>

    <footer class="bg-gray-800 text-white py-12">
        <div class="container mx-auto px-6 text-center">
            <h3 class="text-2xl font-bold mb-4">HoosList</h3>
            <p class="text-gray-300 mb-6">The smart way to discover and plan your UVA academic journey</p>
            <div class="flex justify-center space-x-6 text-sm text-gray-400">
                <span>Built for UVA Students</span>
                <span>•</span>
                <span>Real-Time Data</span>
                <span>•</span>
                <span>Copyright JLD 2026</span>
            </div>
        </div>
    </footer>
</body>
</html>
